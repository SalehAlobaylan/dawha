POSTGRES_DB=dawha
POSTGRES_USER=dawha
POSTGRES_PASSWORD=dawha_local
DATABASE_URL=postgres://dawha:dawha_local@localhost:55432/dawha
VITE_API_URL=http://localhost:8080
CORE_API_PORT=8080
AI_RESEARCH_PORT=8000
AI_RESEARCH_URL=http://localhost:8000
SOURCE_STORAGE_DIR=../../.data/source-storage
APP_ENV=development
WEB_ORIGIN=http://localhost:5173

# --- demo mode (plan 008) ----------------------------------------------------
# OFF unless it is set. The dashboard, and the tree list's no-database fallback,
# serve static payloads only when this is on, and answer a dependency error (503)
# when it is off - so a deployment whose API is up but whose data is not cannot
# show a reader a workspace that does not exist. `npm run dev`, `make e2e` and the
# CI browser job set it explicitly to true; the production posture is off.
#
# The demo responses are labelled three ways: an X-Data-Source: demo header, a
# `mode: "demo"` field and a `demo: true` field, and the web app renders a banner
# above the numbers.
DEMO_MODE=true

# --- storage (plan 008) -------------------------------------------------------
# STORAGE_DRIVER is `local` unless a deployment says otherwise, and there is no
# fallback in either direction: STORAGE_DRIVER=s3 with no bucket refuses to
# start rather than writing uploads to a directory. The API and every worker read
# these same names, so they cannot end up on different stores.
#
#   STORAGE_DRIVER=local|s3            default local
#   SOURCE_STORAGE_DIR=<directory>     the local driver's directory
#   PUBLIC_BASE_URL=<absolute url>     the API's external address, used to build
#                                      signed object URLs. Unset means signed
#                                      download access is unavailable, which is a
#                                      different thing from storage being
#                                      unavailable: uploads still work.
#   STORAGE_SIGNING_SECRET=<32+ bytes> the local signing secret. Unset generates
#                                      one per process, which is right for
#                                      development (every restart invalidates every
#                                      link) and wrong for a deployment, where a
#                                      rolling restart must not break links already
#                                      handed out.
#
# --- storage, S3 driver ------------------------------------------------------
# Names only. No credential value belongs in this file, in a log, or in a plan.
#
#   S3_BUCKET=<bucket>                 required for the s3 driver
#   S3_REGION=<region>                 required for the s3 driver
#   S3_ENDPOINT=<url>                  optional; unset means AWS
#   S3_ACCESS_KEY_ID=<id>              optional; both halves or neither
#   S3_SECRET_ACCESS_KEY=<secret>      optional; otherwise the SDK credential
#                                      chain (environment, shared config, IRSA)
#   S3_USE_PATH_STYLE=true             optional; most S3-compatible servers need
#                                      it, AWS does not
STORAGE_DRIVER=local
PUBLIC_BASE_URL=http://localhost:8080

# --- rate limits (plan 008) ---------------------------------------------------
# The documented defaults apply unless RATE_LIMIT_ENABLED says otherwise: sign-in
# 30 a minute, uploads 20, suggestions 15, research mutations 30, everything else
# 240. Every budget is per client address per minute, the classes do not share a
# budget with each other, and a caller may ask for a SHORTER window than the
# default but never a longer one. A value that does not parse stops the process
# rather than falling back to a default.
#
#   RATE_LIMIT_ENABLED=false|true        default true
#   RATE_LIMIT_WINDOW=1m                  default 1m
#   RATE_LIMIT_AUTH_PER_MINUTE=30
#   RATE_LIMIT_UPLOAD_PER_MINUTE=20
#   RATE_LIMIT_SUGGESTION_PER_MINUTE=15
#   RATE_LIMIT_RESEARCH_PER_MINUTE=30
#   RATE_LIMIT_DEFAULT_PER_MINUTE=240
#
# RATE_LIMIT_ENABLED=false is the development override. `make e2e`, the E2E stack
# and the CI browser job set it explicitly, because twenty-eight journeys share
# one client address.
RATE_LIMIT_ENABLED=true

# --- telemetry (plan 008) ---------------------------------------------------
# OFF by default, and the reason is specific: `make verify` and `make e2e` must not
# be changed by the existence of telemetry, and a second listener on a port
# somebody already uses is a startup failure. When it is off, nothing is
# recorded, nothing is exported and no collector is required - locally or in CI.
#
#   TELEMETRY_METRICS_ENABLED=false|true   default false
#   TELEMETRY_METRICS_ADDR=<host:port>     default 127.0.0.1:9464, loopback
#   TELEMETRY_SERVICE_NAME=<name>          default dawha
#
# When enabled, /metrics is served in the Prometheus text format on that address.
# The label set is a fixed enumeration - method, route family, status class, job
# type, outcome, AI operation, statement kind - and no label can ever carry a
# query, a person's name, source text or any other content.
TELEMETRY_METRICS_ENABLED=false
